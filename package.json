{
  "name": "vite-react-ssg-pro",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && pnpm core:build",
    "core:build": "cross-env NODE_ENV=production vite build && pnpm prerender && pnpm compress",
    "preview": "vite preview",
    "lint": "tsx scripts/lint.ts",
    "unused": "knip --production --dependencies --files --exports --include-entry-exports && depcheck",
    "test": "pnpm lint && pnpm core:build && vite preview",
    "upload": "pnpm build && wrangler pages deploy ./dist",
    "prerender": "tsx --tsconfig tsconfig.app.json scripts/prerender.ts",
    "compress": "tsx --tsconfig tsconfig.app.json scripts/compress.ts",
    "og-screenshots": "python scripts/generate_og_screenshots.py --port 5173 --seo src/seo.json --cleanup",
    "analyze": "cross-env ANALYZE=true pnpm core:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "beasties": "^0.4.3",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "framer-motion": "^12.43.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.31.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "tsx": "^4.23.4",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-inspect": "12.0.2",
    "vite-plugin-qrcode": "^0.4.1",
    "wrangler": "^4.118.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
